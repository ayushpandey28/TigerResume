PORT=5000
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/tigerresume?retryWrites=true&w=majority
JWT_SECRET=generate_a_secure_random_64_character_string_here
JWT_EXPIRES_IN=7d
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
# In production on Render, set this to your Vercel URL e.g. https://your-tiger-resume.vercel.app
FRONTEND_URL=http://localhost:3000
NODE_ENV=production

